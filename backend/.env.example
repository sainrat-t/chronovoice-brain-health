# Copy this file to .env and fill in the keys you have. The .env file is never committed.

# Language model of steps 2 and 4: one key is enough.
# With both keys, LLM_PROVIDER decides (mistral or anthropic); without it, Anthropic is used.
MISTRAL_API_KEY=
# Model chosen for the trials and the demo (2026-11-14). Mistral lists it as deprecated
# since 2026-10-31: if it is retired, remove this line to fall back to the code default,
# mistral-small-latest.
MISTRAL_MODEL=mistral-medium-latest
# Only for models that reason; accepted values depend on the model.
# MISTRAL_REASONING_EFFORT=
ANTHROPIC_API_KEY=
# LLM_PROVIDER=mistral

# Transcription (step 0)
ELEVENLABS_API_KEY=

# Integration endpoint (POST /api/integrations/recordings): without it, the endpoint answers 503.
# INTEGRATION_API_KEY=

# Storage. Defaults: data/chronovoice.sqlite3 and a chronovoice folder in the system temp dir.
# CHRONOVOICE_DB=
# CHRONOVOICE_AUDIO_DIR=
