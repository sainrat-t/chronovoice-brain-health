{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--project",
        "backend",
        "--env-file",
        "backend/.env",
        "uvicorn",
        "--app-dir",
        "backend",
        "app.main:app",
        "--port",
        "8001"
      ],
      "port": 8001,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_TARGET=http://127.0.0.1:8001",
        "npm",
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173,
      "autoPort": false
    }
  ]
}
